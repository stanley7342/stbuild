{
  "name": "stbuild",
  "displayName": "史丹利測試",
  "description": "史丹利測試, flash, and serial monitor for CMake-based embedded projects",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.110.0"
  },
  "extensionDependencies": [
    "marus25.cortex-debug"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:CMakeLists.txt"
  ],
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcuBuild.build",
        "title": "MCU: Build",
        "icon": "$(play)"
      },
      {
        "command": "mcuBuild.clean",
        "title": "MCU: Clean",
        "icon": "$(trash)"
      },
      {
        "command": "mcuBuild.rebuild",
        "title": "MCU: Compile",
        "icon": "$(play)"
      },
      {
        "command": "mcuBuild.flash",
        "title": "MCU: Flash Firmware",
        "icon": "$(zap)"
      },
      {
        "command": "mcuBuild.openFlashPanel",
        "title": "MCU: Open Flash Panel (UART)",
        "icon": "$(zap)"
      },
      {
        "command": "mcuBuild.openSerialMonitor",
        "title": "MCU: Open Serial Monitor",
        "icon": "$(terminal)"
      },
      {
        "command": "mcuBuild.selectBuildType",
        "title": "MCU: Select Build Type"
      },
      {
        "command": "mcuBuild.selectSerialPort",
        "title": "MCU: Select Serial Port"
      },
      {
        "command": "mcuBuild.selectSourceFolder",
        "title": "MCU: Select Source Folder",
        "icon": "$(folder)"
      },
      {
        "command": "mcuBuild.selectConfigFile",
        "title": "MCU: Select Config File",
        "icon": "$(file-code)"
      },
      {
        "command": "mcuBuild.openConfigFile",
        "title": "MCU: Open Config File Editor",
        "icon": "$(edit)"
      },
      {
        "command": "mcuBuild.clearConfigFile",
        "title": "MCU: Clear Config File",
        "icon": "$(close)"
      },
      {
        "command": "mcuBuild.openFile",
        "title": "MCU: Open File"
      },
      {
        "command": "mcuBuild.revealOutputFile",
        "title": "MCU: Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcuBuild.useAsFlashBin",
        "title": "MCU: Use as Flash BIN",
        "icon": "$(zap)"
      },
      {
        "command": "mcuBuild.installArmToolchain",
        "title": "MCU: Install ARM Cortex-M Toolchain",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcuBuild.installCmake",
        "title": "MCU: Install CMake",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcuBuild.installNinja",
        "title": "MCU: Install Ninja",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcuBuild.removeArmToolchain",
        "title": "MCU: Remove ARM Cortex-M Toolchain",
        "icon": "$(trash)"
      },
      {
        "command": "mcuBuild.removeCmake",
        "title": "MCU: Remove CMake",
        "icon": "$(trash)"
      },
      {
        "command": "mcuBuild.removeNinja",
        "title": "MCU: Remove Ninja",
        "icon": "$(trash)"
      },
      {
        "command": "mcuBuild.refreshToolchain",
        "title": "MCU: Refresh Toolchain Status",
        "icon": "$(sync)"
      },
      {
        "command": "mcuBuild.configSave",
        "title": "MCU: Save Config",
        "icon": "$(save)"
      },
      {
        "command": "mcuBuild.configToggleBool",
        "title": "MCU: Toggle Config Bool"
      },
      {
        "command": "mcuBuild.configEditValue",
        "title": "MCU: Edit Config Value",
        "icon": "$(edit)"
      },
      {
        "command": "mcuBuild.startDebug",
        "title": "MCU: Start CMSIS-DAP Debug",
        "icon": "$(debug-start)"
      },
      {
        "command": "mcuBuild.debug.selectElf",
        "title": "MCU: Select ELF File",
        "icon": "$(file-binary)"
      },
      {
        "command": "mcuBuild.debug.selectInterface",
        "title": "MCU: Select Debug Interface",
        "icon": "$(plug)"
      },
      {
        "command": "mcuBuild.debug.selectTarget",
        "title": "MCU: Select OpenOCD Target",
        "icon": "$(settings)"
      },
      {
        "command": "mcuBuild.debug.selectOpenOcd",
        "title": "MCU: Select OpenOCD",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mcuBuild.debug.selectGdb",
        "title": "MCU: Select GDB Path",
        "icon": "$(terminal)"
      },
      {
        "command": "mcuBuild.debug.generateLaunch",
        "title": "MCU: Generate launch.json",
        "icon": "$(file-code)"
      },
      {
        "command": "mcuBuild.debug.flashOpenOcd",
        "title": "MCU: Flash Firmware (OpenOCD)",
        "icon": "$(zap)"
      },
      {
        "command": "mcuBuild.sdk.fetchTags",
        "title": "SDK: Fetch Available Versions",
        "icon": "$(sync)"
      },
      {
        "command": "mcuBuild.sdk.install",
        "title": "SDK: Install Version",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcuBuild.sdk.remove",
        "title": "SDK: Remove Version",
        "icon": "$(trash)"
      },
      {
        "command": "mcuBuild.sdk.setInstallPath",
        "title": "SDK: Set Install Path",
        "icon": "$(folder)"
      },
      {
        "command": "mcuBuild.sdk.openFolder",
        "title": "SDK: Open Installed Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcuBuild.sdk.openAsWorkspace",
        "title": "SDK: Open as Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcuBuild.openDocs",
        "title": "MCU: Open Documentation",
        "icon": "$(book)"
      },
      {
        "command": "mcuBuild.openDocsAt",
        "title": "MCU: Open Documentation Section"
      },
      {
        "command": "mcuBuild.openSettings",
        "title": "MCU: Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "史丹利測試",
      "properties": {
        "mcuBuild.cmake.buildDirectory": {
          "type": "string",
          "default": "${workspaceFolder}/build",
          "description": "CMake build output directory"
        },
        "mcuBuild.cmake.cmakePath": {
          "type": "string",
          "default": "C:/Users/Stanley/AppData/Local/Python/pythoncore-3.14-64/Lib/site-packages/cmake/data/bin/cmake.exe",
          "description": "Path to the cmake executable"
        },
        "mcuBuild.cmake.ninjaPath": {
          "type": "string",
          "default": "ninja",
          "description": "Path to the ninja executable"
        },
        "mcuBuild.cmake.buildType": {
          "type": "string",
          "enum": [
            "Debug",
            "Release",
            "RelWithDebInfo",
            "MinSizeRel"
          ],
          "default": "Debug",
          "description": "CMake build type"
        },
        "mcuBuild.cmake.configFile": {
          "type": "string",
          "default": "",
          "description": "CMake initial cache file passed via -C (e.g. a .config or .cmake file)"
        },
        "mcuBuild.cmake.toolchainFile": {
          "type": "string",
          "default": "",
          "description": "Path to CMake toolchain file (e.g. arm-none-eabi toolchain)"
        },
        "mcuBuild.cmake.generator": {
          "type": "string",
          "default": "",
          "description": "CMake generator (e.g. 'Ninja', 'Unix Makefiles'). Leave empty for default."
        },
        "mcuBuild.cmake.configureArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional CMake configure arguments"
        },
        "mcuBuild.cmake.buildArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional CMake build arguments (appended after --build <dir>)"
        },
        "mcuBuild.flash.tool": {
          "type": "string",
          "enum": [
            "openocd",
            "esptool",
            "custom"
          ],
          "default": "openocd",
          "description": "Flash tool to use"
        },
        "mcuBuild.flash.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "Path to openocd executable"
        },
        "mcuBuild.flash.openocdInterface": {
          "type": "string",
          "default": "interface/stlink.cfg",
          "description": "OpenOCD interface config file"
        },
        "mcuBuild.flash.openocdTarget": {
          "type": "string",
          "default": "target/stm32f4x.cfg",
          "description": "OpenOCD target config file"
        },
        "mcuBuild.flash.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Firmware binary path relative to build directory (e.g. 'firmware.elf'). Auto-detected if empty."
        },
        "mcuBuild.flash.ispToolPath": {
          "type": "string",
          "default": "C:\\Users\\Stanley\\rex_hand_over\\isp_download_cmd_tool\\isp_dw_cmd.exe",
          "description": "Path to isp_dw_cmd.exe (or isp_download_tool.exe). Relative paths are resolved from the workspace root. Absolute paths are used as-is."
        },
        "mcuBuild.flash.customCommand": {
          "type": "string",
          "default": "",
          "description": "Custom flash command (used when flash.tool is 'custom')"
        },
        "mcuBuild.serial.port": {
          "type": "string",
          "default": "",
          "description": "Serial port for serial monitor (e.g. COM3 or /dev/ttyUSB0)"
        },
        "mcuBuild.serial.baudRate": {
          "type": "number",
          "default": 115200,
          "description": "Serial baud rate"
        },
        "mcuBuild.cmake.chipName": {
          "type": "string",
          "enum": ["rf1301","rt581","rt582","rt583","rt584ha4","rt584h","rt584l"],
          "default": "",
          "description": "Rafael chip name — selects the matching default-<chip>-evb.config file"
        },
        "mcuBuild.debug.elfFile": {
          "type": "string",
          "default": "",
          "description": "Path to ELF file for CMSIS-DAP debugging"
        },
        "mcuBuild.debug.gdbPath": {
          "type": "string",
          "default": "arm-none-eabi-gdb",
          "description": "Path to arm-none-eabi-gdb executable"
        },
        "mcuBuild.debug.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "Path to OpenOCD executable"
        },
        "mcuBuild.debug.interfaceCfg": {
          "type": "string",
          "default": "interface/cmsis-dap.cfg",
          "description": "OpenOCD interface config file (e.g. interface/cmsis-dap.cfg)"
        },
        "mcuBuild.debug.targetCfg": {
          "type": "string",
          "default": "target/rt584.cfg",
          "description": "OpenOCD target config file (e.g. target/rt584.cfg)"
        },
        "mcuBuild.debug.gdbPort": {
          "type": "number",
          "default": 50000,
          "description": "GDB server port used by OpenOCD (openocd_rt58x.sh default: 50000)"
        },
        "mcuBuild.debug.device": {
          "type": "string",
          "default": "RT584L",
          "description": "Target device name"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcuBuildContainer",
          "title": "史丹利測試",
          "icon": "resources/mcu.svg"
        }
      ]
    },
    "views": {
      "mcuBuildContainer": [
        {
          "id": "mcuBuildView",
          "name": "史丹利測試"
        },
        {
          "id": "mcuSdkView",
          "name": "SDK Manager"
        },
        {
          "id": "mcuDocsView",
          "name": "Documentation"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mcuBuild.build",
          "when": "view == mcuBuildView",
          "group": "navigation"
        },
        {
          "command": "mcuBuild.flash",
          "when": "view == mcuBuildView",
          "group": "navigation"
        },
        {
          "command": "mcuBuild.sdk.fetchTags",
          "when": "view == mcuSdkView",
          "group": "navigation"
        },
        {
          "command": "mcuBuild.openSettings",
          "when": "view == mcuBuildView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mcuBuild.rebuild",
          "when": "view == mcuBuildView && viewItem == build",
          "group": "inline"
        },
        {
          "command": "mcuBuild.revealOutputFile",
          "when": "view == mcuBuildView && viewItem == outputFile",
          "group": "inline"
        },
        {
          "command": "mcuBuild.useAsFlashBin",
          "when": "view == mcuBuildView && viewItem == outputFile",
          "group": "inline"
        },
        {
          "command": "mcuBuild.selectConfigFile",
          "when": "view == mcuBuildView && (viewItem == configFile || viewItem == configFileSet)",
          "group": "inline"
        },
        {
          "command": "mcuBuild.clearConfigFile",
          "when": "view == mcuBuildView && viewItem == configFileSet",
          "group": "inline"
        },
        {
          "command": "mcuBuild.selectBuildType",
          "when": "view == mcuBuildView && viewItem == buildType",
          "group": "inline"
        },
        {
          "command": "mcuBuild.flash",
          "when": "view == mcuBuildView && viewItem == flash",
          "group": "inline"
        },
        {
          "command": "mcuBuild.openSerialMonitor",
          "when": "view == mcuBuildView && viewItem == openSerial",
          "group": "inline"
        },
        {
          "command": "mcuBuild.selectSerialPort",
          "when": "view == mcuBuildView && viewItem == selectPort",
          "group": "inline"
        },
        {
          "command": "mcuBuild.installArmToolchain",
          "when": "view == mcuBuildView && viewItem == armToolchain",
          "group": "inline"
        },
        {
          "command": "mcuBuild.installCmake",
          "when": "view == mcuBuildView && viewItem == cmakeToolchain",
          "group": "inline"
        },
        {
          "command": "mcuBuild.installNinja",
          "when": "view == mcuBuildView && viewItem == ninjaToolchain",
          "group": "inline"
        },
        {
          "command": "mcuBuild.removeArmToolchain",
          "when": "view == mcuBuildView && viewItem == armToolchainOk",
          "group": "inline"
        },
        {
          "command": "mcuBuild.removeCmake",
          "when": "view == mcuBuildView && viewItem == cmakeToolchainOk",
          "group": "inline"
        },
        {
          "command": "mcuBuild.removeNinja",
          "when": "view == mcuBuildView && viewItem == ninjaToolchainOk",
          "group": "inline"
        },
        {
          "command": "mcuBuild.refreshToolchain",
          "when": "view == mcuBuildView && viewItem == toolchainGroup",
          "group": "inline"
        },
        {
          "command": "mcuBuild.startDebug",
          "when": "view == mcuBuildView && viewItem == debugStart",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.selectElf",
          "when": "view == mcuBuildView && viewItem == debugElf",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.selectInterface",
          "when": "view == mcuBuildView && viewItem == debugInterface",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.selectTarget",
          "when": "view == mcuBuildView && viewItem == debugTarget",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.selectOpenOcd",
          "when": "view == mcuBuildView && viewItem == debugOpenOcd",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.selectGdb",
          "when": "view == mcuBuildView && viewItem == debugGdb",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.generateLaunch",
          "when": "view == mcuBuildView && viewItem == debugGenLaunch",
          "group": "inline"
        },
        {
          "command": "mcuBuild.debug.flashOpenOcd",
          "when": "view == mcuBuildView && viewItem == debugFlash",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.fetchTags",
          "when": "view == mcuSdkView && viewItem == sdkFetchTags",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.install",
          "when": "view == mcuSdkView && viewItem == sdkTag",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.remove",
          "when": "view == mcuSdkView && viewItem == sdkTagInstalled",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.remove",
          "when": "view == mcuSdkView && viewItem == sdkInstalledItem",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.openFolder",
          "when": "view == mcuSdkView && viewItem == sdkInstalledItem",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.setInstallPath",
          "when": "view == mcuSdkView && viewItem == sdkInstallPath",
          "group": "inline"
        },
        {
          "command": "mcuBuild.sdk.openAsWorkspace",
          "when": "view == mcuSdkView && viewItem == sdkFolder",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mcuBuild.rebuild",
        "key": "f7",
        "when": "!inDebugMode"
      },
      {
        "command": "mcuBuild.flash",
        "key": "ctrl+f7",
        "when": "!inDebugMode"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
